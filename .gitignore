# data/ is ~1.5 GB. The source docking files are 695 MB each and the frozen CV splits
# are 112 MB, so nothing under data/ is tracked by default -- see CLAUDE.md, which flags
# deciding .gitignore vs git-LFS as a prerequisite to committing anything here.
#
# The exception is data/reference/: a few hundred KB of frozen MiniMol embeddings that
# src/verify_trunk.py checks the trainable trunk against. That fixture is only useful if
# it travels with the code, so it is un-ignored below.
data/*
!data/reference/
!data/*.meta.json

# Regenerable in ~2.5 min from src/split.py, and 112 MB.
data/splits/

# Recreated by `uv sync` from the tracked pyproject.toml + uv.lock. ~5 GB with the CUDA
# wheels, and it is platform-specific -- it must never travel to another cluster.
.venv/

# The minimol 1.3.4 wheel is 19 MB because it carries the pretrained weights. Kept as a
# hedge against PyPI, but too big to track -- see NOTES on rebuilding it.
vendor/

__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Training run artifacts: a 34 MB checkpoint plus predictions per run, and the 5x2 grid
# makes 10 of them. meta.json records everything needed to reproduce a run, so the
# artifacts themselves are regenerable.
outputs/

# wandb and SLURM leave these behind; logs live in /home/ethan2/logs/ by convention.
wandb/
*.out
*.err
